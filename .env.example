# Sarvam AI API Credentials for STT, TTS, and LLM
SARVAM_API_KEY=
LLM_API_KEY=

# Authentication secret
AUTH_SECRET=change-this-in-production

# CORS allowed origins (comma-separated if deploying frontend separately)
CORS_ORIGINS=https://arogya-nexus.onrender.com

# Server Port (assigned dynamically on Render)
PORT=8000

# Frontend API Base URL (set in Vite build if frontend deployed separately from backend)
# VITE_API_BASE_URL=https://your-backend.onrender.com
